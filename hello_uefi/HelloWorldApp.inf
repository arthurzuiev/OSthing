[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = HelloWorldApp
  FILE_GUID                      = 12345678-1234-1234-1234-1234567890ab
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = HelloWorldAppEntry
  IMAGE_ENTRY_POINT              = HelloWorldAppEntry

[Sources]
  HelloWorldApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  PrintLib
  BaseLib

[BuildOptions]
  MSFT:*_*_CC_FLAGS = /GS- /Gs9999999 /GR- /EHs /EHc-
  MSFT:*_*_LD_FLAGS = /NODEFAULTLIB
